# Optional Postgres connection. Leave unset to use the embedded PGLite database.
DATABASE_URL=

# First-party Google OAuth (both values are required to show the Google button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign Better Auth sessions in deployed environments.
BETTER_AUTH_SECRET=
# Public origin used by Better Auth for deployed OAuth callbacks.
BETTER_AUTH_URL=http://localhost:8080

# The Grok broker is disabled by default because its shared preview client only
# accepts callbacks on *.grok-sandbox.com. Set true only for that environment.
GROK_AUTH_BROKER_ENABLED=false

# Set false to use the shared dev user and disable real authentication.
VITE_AUTH_ENABLED=true

# Optional xAI API key for app features that call xAI.
XAI_API_KEY=
